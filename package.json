{
  "name": "ee-circuit-draw-simulator",
  "version": "0.2.1",
  "description": "Agent skill for real circuit simulation: draw, simulate, measure, plot and share circuits instead of guessing numbers.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/blankwy/ee-circuit-draw-simulator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blankwy/ee-circuit-draw-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/blankwy/ee-circuit-draw-simulator/issues"
  },
  "bin": {
    "ee-circuit-draw-simulator": "./scripts/circuitlab.mjs",
    "circuitlab": "./scripts/circuitlab.mjs"
  },
  "files": [
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "scripts/",
    "references/"
  ],
  "scripts": {
    "setup": "node scripts/circuitlab.mjs setup",
    "probe": "node scripts/circuitlab.mjs probe",
    "check": "node --check scripts/circuitlab.mjs && node --check scripts/lib/backend.mjs && node --check scripts/lib/svg.mjs && node --check scripts/lib/units.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "codex",
    "deepseek-harness",
    "circuit",
    "circuit-simulation",
    "electronics",
    "spice",
    "schematic",
    "waveform",
    "education"
  ]
}
