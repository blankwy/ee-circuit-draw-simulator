{
  "name": "ee-circuit-draw-simulator",
  "version": "0.3.1",
  "description": "Agent skill for real circuit simulation: draw, simulate, measure, plot and share circuits instead of guessing numbers.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/blankwy/ee-circuit-draw-simulator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blankwy/ee-circuit-draw-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/blankwy/ee-circuit-draw-simulator/issues"
  },
  "bin": {
    "ee-circuit-draw-simulator": "scripts/circuitlab.mjs",
    "circuitlab": "scripts/circuitlab.mjs"
  },
  "files": [
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "assets/icon.svg",
    "assets/icon-256.png",
    "scripts/",
    "references/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "setup": "node scripts/circuitlab.mjs setup",
    "probe": "node scripts/circuitlab.mjs probe",
    "check": "node --check scripts/circuitlab.mjs && node --check scripts/lib/backend.mjs && node --check scripts/lib/svg.mjs && node --check scripts/lib/units.mjs && node --check scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm run smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "codex",
    "deepseek-harness",
    "circuit",
    "circuit-simulation",
    "electronics",
    "spice",
    "schematic",
    "waveform",
    "education"
  ]
}
