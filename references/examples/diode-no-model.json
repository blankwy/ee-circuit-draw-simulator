{
  "schema": "netlist/0.1",
  "_comment": "反例：二极管少了必填的 modelName。CLI 会在载入阶段把它点名（load.missingProps），而不是等仿真停在 t=0 再说一句“卡住或不收敛”。",
  "components": [
    { "id": "v1", "type": "VoltageElm", "props": { "waveform": 1, "frequency": 50, "maxVoltage": 10 } },
    { "id": "d1", "type": "DiodeElm", "props": {} },
    { "id": "r1", "type": "ResistorElm", "props": { "resistance": 1000 } },
    { "id": "g1", "type": "GroundElm", "props": {} }
  ],
  "nets": [
    { "id": "ac", "pins": ["v1:1", "d1:0"] },
    { "id": "dc", "pins": ["d1:1", "r1:0"] },
    { "id": "gnd", "pins": ["v1:0", "r1:1", "g1:0"], "ground": true }
  ]
}
